APP_ENV=development
SECRET_KEY=change-me

# To use PostgreSQL, change DATABASE_URL in .env to postgresql://user:password@localhost:5432/linkforge
DATABASE_URL=sqlite:///linkforge.db
BASE_URL=http://127.0.0.1:5000
SHORT_CODE_LENGTH=6
MAX_URL_LENGTH=2048

BLOCKED_DOMAINS=
PROXY_COUNT=0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_CREATE=10 per minute;200 per day
RATELIMIT_REDIRECT=120 per minute

# Used only by docker compose
POSTGRES_PASSWORD=linkforge
